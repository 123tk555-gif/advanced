{
  "name": "tritri",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p api && tsc -p infra && corepack pnpm --filter @tritri/web typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "corepack pnpm --filter @tritri/e2e test",
    "dev:api": "corepack pnpm --filter @tritri/api dev",
    "dev:web": "corepack pnpm --filter @tritri/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
